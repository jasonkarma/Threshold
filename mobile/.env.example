# Threshold — app environment
#
# Copy to `.env` (same directory) and fill in your values:
#   cp .env.example .env
#
# Only EXPO_PUBLIC_* variables reach app code. Expo inlines them into the
# bundle at build time, so anything here is PUBLIC — never put a model-provider
# key (OpenAI, Anthropic, …) in this file. The provider key belongs in
# ../server/.env, behind the route below.
#
# Restart the dev server after editing (`npm run web` / `npm run ios`) — Expo
# inlines at bundle time, so a hot reload will not pick up a change.

# Base URL of the campaign backend, no trailing slash.
# Local, the server in ../server:  http://localhost:8787
# Hosted:                          https://api.your-domain.com
#
# Leave BLANK to run the built-in demo campaign with no server at all — a fixed
# 10-level networking path, not generation.
EXPO_PUBLIC_API_URL=

# Client key the app sends as `Authorization: Bearer ...` to that backend.
# Must match CLIENT_API_KEY in ../server/.env. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
#
# This is public by construction — it ships inside the app bundle. It gates our
# own /campaigns route; it does not identify a user.
EXPO_PUBLIC_API_KEY=
