# Threshold — campaign backend
#
# Copy to `.env` (same directory) and fill in the values:
#   cp .env.example .env
#
# Unlike mobile/.env, NOTHING here reaches the app bundle. This is the only
# place the billable gateway key exists.

# ------------------------------------------------------------------- server ---

# Port this server listens on. The app must point at the same value.
PORT=8787

# Token the app sends as `Authorization: Bearer`. It ships inside the Expo
# bundle, so treat it as public — it deters casual abuse, it does not secure
# anything. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Blank disables the check (local use only; the server warns at boot).
CLIENT_API_KEY=

# Generations allowed per client key per hour. 0 disables the limit.
RATE_LIMIT_PER_HOUR=20

# ------------------------------------------------------------------ gateway ---

# Base URL of the LLM gateway, including /v1, without a trailing slash.
# Note this is NOT the same value as the app's EXPO_PUBLIC_API_URL — that one
# points at this server, not at the gateway.
LLM_BASE_URL=https://lumiarouter.com/v1

# Model ID passed to the gateway. Confirmed present in its catalogue.
# Slower/cheaper alternatives worth trying if generations approach the
# deadline: claude-opus-5-5-medium, then claude-sonnet-5-5.
LLM_MODEL=claude-opus-5-5

# The billable provider key for the gateway. NEVER commit this, and never put
# it in mobile/.env — anything there is inlined into the app bundle.
LLM_API_KEY=

# Cap on generated tokens. Too low truncates the JSON mid-array, which fails
# as "invalid JSON" with no obvious cause. 8192 is a safe floor for a
# 8-10 mission path with descriptions.
LLM_MAX_TOKENS=8192

# ------------------------------------------------------------------ timing ---

# Per-attempt gateway timeout, in milliseconds.
LLM_TIMEOUT_MS=40000

# Total budget for one generation, including the repair retry. MUST stay below
# 60000 — the app aborts at 60s, and the server has to fail first with a reason
# the log can show. The server refuses to boot if this is >= 60000.
OVERALL_DEADLINE_MS=50000
